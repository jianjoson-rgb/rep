                    optional_columns=TICKETS_OPTIONAL_COLUMNS,
                )
            )

            chunk_iter = pd.read_csv(
                local_csv,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
                chunksize=CSV_CHUNK_SIZE,
                usecols=actual_columns,
            )

            for chunk_number, chunk in enumerate(
                chunk_iter,
                start=1,
            ):
                chunk = chunk.rename(columns=rename_map)

                for optional_column in TICKETS_OPTIONAL_COLUMNS:
                    if optional_column not in chunk.columns:
                        chunk[optional_column] = ""

                company_mask = (
                    normalize_lookup_series(
                        chunk[TICKETS_COMPANY_COLUMN]
                    )
                    == company_target
                )
                date_series = parse_dates_general(
                    chunk[TICKETS_DATE_COLUMN]
                )
                base_mask = company_mask & date_series.notna()

                ticket_id_series = normalize_ticket_id_series(
                    chunk["ticket_id"]
                )
                employee_name_display = normalize_display_series(
                    chunk["employee_full_name"]
                )
                employee_name_lookup = normalize_lookup_series(
                    chunk["employee_full_name"]
                )
                combined_key_series = build_combined_key_series(
                    ticket_id_series,
                    employee_name_display,
                )

                tenure_display = normalize_display_series(
                    chunk["agent_tenure"]
                )
                tenure_lookup = normalize_lookup_series(
                    chunk["agent_tenure"]
                )
                tenure_mask = (
                    base_mask
                    & ~tenure_lookup.isin(
                        INVALID_LOOKUP_VALUES
                    )
                    & tenure_display.ne("")
                )

                combined_mask = (
                    tenure_mask
                    & combined_key_series.isin(
                        needed_combined_keys
                    )
                )
                matched_rows += int(combined_mask.sum())

                for combined_key, value, record_date in zip(
                    combined_key_series.loc[
                        combined_mask
                    ].tolist(),
                    tenure_display.loc[
                        combined_mask
                    ].tolist(),
                    date_series.loc[
                        combined_mask
                    ].tolist(),
                ):
                    existing = tenure_combined_best.get(
                        combined_key
                    )
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        tenure_combined_best[combined_key] = {
                            "value": value,
                            "date": record_date,
                        }

                name_mask = (
                    tenure_mask
                    & employee_name_lookup.isin(
                        needed_name_keys
                    )
                )

                for name_key, value, record_date in zip(
                    employee_name_lookup.loc[name_mask].tolist(),
                    tenure_display.loc[name_mask].tolist(),
                    date_series.loc[name_mask].tolist(),
                ):
                    existing = tenure_name_best.get(name_key)
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        tenure_name_best[name_key] = {
                            "value": value,
                            "date": record_date,
                        }

                site_source_lookup = normalize_lookup_series(
                    chunk["bpo_location"]
                )
                site_code_series = site_source_lookup.map(
                    TICKETS_SITE_TO_CODE
                )
                site_mask = (
                    base_mask
                    & employee_name_lookup.isin(
                        needed_name_keys
                    )
                    & site_code_series.notna()
                )

                for name_key, site_code, record_date in zip(
                    employee_name_lookup.loc[site_mask].tolist(),
                    site_code_series.loc[site_mask].tolist(),
                    date_series.loc[site_mask].tolist(),
                ):
                    existing = site_name_best.get(name_key)
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        site_name_best[name_key] = {
                            "value": site_code,
                            "date": record_date,
                        }

                if chunk_number % 5 == 0:
                    PROGRESS.set_message(
                        f"Ticket {file_name}: "
                        f"{matched_rows:,} matched rows"
                    )

        except Exception as exc:
            file_status = f"FAILED: {exc}"
            print(
                f"ERROR processing ticket lookup file "
                f"{file_name}: {exc}"
            )
            raise

        finally:
            summary_rows.append(
                [
                    "TICKET_LOOKUPS",
                    run_timestamp,
                    LOOKBACK_WEEKS,
                    str(window_start_date),
                    str(window_end_date),
                    latest_file_name,
                    str(reference_latest_date),
                    file_name,
                    modified_time,
                    file_size_mb,
                    matched_rows,
                    file_status,
                ]
            )
            safe_cleanup_file(local_csv)
            PROGRESS.update(
                1,
                f"Ticket file complete: {file_name}",
            )

    return {
        "tenure_combined": {
            key: value["value"]
            for key, value in tenure_combined_best.items()
        },
        "tenure_name": {
            key: value["value"]
            for key, value in tenure_name_best.items()
        },
        "site_name": {
            key: value["value"]
            for key, value in site_name_best.items()
        },
    }


