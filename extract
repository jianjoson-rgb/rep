def extract_google_id(url: str) -> str:
    patterns = [
        r"/d/([a-zA-Z0-9-_]+)",
        r"/folders/([a-zA-Z0-9-_]+)",
        r"id=([a-zA-Z0-9-_]+)",
    ]
    for pattern in patterns:
        match = re.search(pattern, str(url))
        if match:
            return match.group(1)
    raise ValueError(f"Could not extract Google ID from URL: {url}")


