def enrich_and_calculate(
    merchant_df,
    taxonomy_lookups,
    ticket_lookups,
    audit_lookup_df,
):
    print("======================================")
    print("ENRICH + CALCULATE START")
    print("======================================")
    PROGRESS.set_message(
        "Enriching and calculating final raw data"
    )

    if merchant_df.empty:
        return pd.DataFrame(columns=FINAL_OUTPUT_COLUMNS)

    working_df = merchant_df.copy()
    working_df["Ticket ID"] = normalize_ticket_id_series(
        working_df["Ticket ID"]
    )

    taxonomy_lookup_df = taxonomy_lookups["enrich_df"]

    if taxonomy_lookup_df.empty:
        working_df["Created Date"] = NULL_TEXT
        working_df["Created Date Raw"] = pd.NaT
        working_df["Level One"] = NULL_TEXT
        working_df["Level Two"] = NULL_TEXT
    else:
        taxonomy_lookup_df = taxonomy_lookup_df.copy()
        taxonomy_lookup_df["Ticket ID"] = (
            normalize_ticket_id_series(
                taxonomy_lookup_df["Ticket ID"]
            )
        )
        working_df = working_df.merge(
            taxonomy_lookup_df,
            on="Ticket ID",
            how="left",
            validate="many_to_one",
        )

    if audit_lookup_df.empty:
        for column in AUDIT_OUTPUT_COLUMNS:
            working_df[column] = NULL_TEXT
    else:
        audit_lookup_df = audit_lookup_df.copy()
        audit_lookup_df["Ticket ID"] = (
            normalize_ticket_id_series(
                audit_lookup_df["Ticket ID"]
            )
        )

        if audit_lookup_df["Ticket ID"].duplicated().any():
            duplicates = audit_lookup_df.loc[
                audit_lookup_df["Ticket ID"].duplicated(
                    keep=False
                ),
                "Ticket ID",
            ].unique().tolist()
            raise ValueError(
                "Elevate QA lookup contains duplicate Ticket IDs "
                f"after resolution: {duplicates[:20]}"
            )

        working_df = working_df.merge(
            audit_lookup_df,
            on="Ticket ID",
            how="left",
            validate="many_to_one",
        )

    working_df["Smiley Registered At"] = parse_dates_general(
        working_df["Smiley Registered At"]
    )
    smiley_dt = working_df["Smiley Registered At"]

    for column in [
        "Level One",
        "Level Two",
        "Created Date",
    ]:
        working_df[column] = (
            working_df[column]
            .replace("", pd.NA)
            .fillna(NULL_TEXT)
            .astype(str)
        )

    for column in AUDIT_TEXT_OUTPUT_COLUMNS:
        working_df[column] = (
            working_df[column]
            .replace("", pd.NA)
            .fillna(NULL_TEXT)
            .astype(str)
        )

    for column in AUDIT_BINARY_OUTPUT_COLUMNS:
        working_df[column] = working_df[column].map(
            normalize_audit_binary_value
        )

    created_dt = pd.to_datetime(
        working_df["Created Date Raw"],
        errors="coerce",
    )

    working_df["Date"] = format_datevalue_output(smiley_dt)
    working_df["Week"] = compute_week_label(smiley_dt)
    working_df["Month"] = format_month_output(smiley_dt)

    rating_series = (
        working_df["Smiley Rating"]
        .astype(str)
        .str.strip()
    )
    working_df["Smiley Rate"] = (
        rating_series.eq("Smiley").astype("int64")
    )
    working_df["Non-Smiley Survey"] = (
        ~rating_series.eq("Smiley")
    ).astype("int64")
    working_df["Responses"] = (
        working_df["Smiley Rate"]
        + working_df["Non-Smiley Survey"]
    ).astype("int64")

    working_df["Ticket Age"] = compute_ticket_age(
        smiley_dt,
        created_dt,
        null_text=NULL_TEXT,
    )
    working_df["Smiley Registered At"] = (
        format_created_date_output(
            smiley_dt,
            null_text=NULL_TEXT,
        )
    )

    combined_key_series = build_combined_key_series(
        working_df["Ticket ID"],
        working_df["Employee Name"],
    )
    name_key_series = normalize_lookup_series(
        working_df["Employee Name"]
    )

    ticket_combined_series = combined_key_series.map(
        ticket_lookups.get("tenure_combined", {})
    )
    taxonomy_combined_series = combined_key_series.map(
        taxonomy_lookups.get("tenure_combined", {})
    )
    ticket_name_series = name_key_series.map(
        ticket_lookups.get("tenure_name", {})
    )
    taxonomy_name_series = name_key_series.map(
        taxonomy_lookups.get("tenure_name", {})
    )

    tenure_group = pd.Series(
        [NULL_TEXT] * len(working_df),
        index=working_df.index,
        dtype="object",
    )

    for candidate_series in [
        ticket_combined_series,
        taxonomy_combined_series,
        ticket_name_series,
        taxonomy_name_series,
    ]:
        candidate_display = candidate_series.map(
            normalize_display_text
        )
        usable_mask = candidate_display.map(
            is_usable_lookup_value
        )
        fill_mask = (
            tenure_group.eq(NULL_TEXT)
            & usable_mask
        )
        tenure_group.loc[fill_mask] = (
            candidate_display.loc[fill_mask]
        )

    working_df["Tenure Group"] = (
        tenure_group
        .replace("", pd.NA)
        .fillna(NULL_TEXT)
        .astype(str)
    )

    ticket_site_series = name_key_series.map(
        ticket_lookups.get("site_name", {})
    )
    taxonomy_site_series = name_key_series.map(
        taxonomy_lookups.get("site_name", {})
    )

    site_series = pd.Series(
        [NULL_TEXT] * len(working_df),
        index=working_df.index,
        dtype="object",
    )

    for candidate_series in [
        ticket_site_series,
        taxonomy_site_series,
    ]:
        candidate_display = candidate_series.map(
            normalize_display_text
        )
        usable_mask = candidate_display.map(
            is_usable_lookup_value
        )
        fill_mask = (
            site_series.eq(NULL_TEXT)
            & usable_mask
        )
        site_series.loc[fill_mask] = (
            candidate_display.loc[fill_mask]
        )

    working_df["Site"] = (
        site_series
        .replace("", pd.NA)
        .fillna(NULL_TEXT)
        .astype(str)
    )

    working_df["Ramp"] = compute_ramp_from_tenure_group(
        working_df["Tenure Group"],
        null_text=NULL_TEXT,
    )

    working_df = working_df.drop(
        columns=["Created Date Raw"],
        errors="ignore",
    )

    null_default_columns = {
        "Level One",
        "Level Two",
        "Created Date",
        "Ticket Age",
        "Tenure Group",
        "Site",
        "Ramp",
        *AUDIT_TEXT_OUTPUT_COLUMNS,
    }

    for column in FINAL_OUTPUT_COLUMNS:
        if column not in working_df.columns:
            working_df[column] = (
                NULL_TEXT
                if (
                    column in null_default_columns
                    or column in AUDIT_BINARY_OUTPUT_COLUMNS
                )
                else ""
            )

    final_df = working_df[FINAL_OUTPUT_COLUMNS].copy()

    for column in null_default_columns:
        final_df[column] = (
            final_df[column]
            .replace("", pd.NA)
            .fillna(NULL_TEXT)
            .astype(str)
        )

    for column in AUDIT_BINARY_OUTPUT_COLUMNS:
        final_df[column] = final_df[column].map(
            normalize_audit_binary_value
        )

    for column in NUMERIC_OUTPUT_COLUMNS:
        final_df[column] = (
            pd.to_numeric(
                final_df[column],
                errors="coerce",
            )
            .fillna(0)
            .astype("int64")
        )

    for column in final_df.columns:
        if (
            column not in NUMERIC_OUTPUT_COLUMNS
            and column not in DATEVALUE_OUTPUT_COLUMNS
            and column not in AUDIT_BINARY_OUTPUT_COLUMNS
        ):
            final_df[column] = (
                final_df[column]
                .fillna("")
                .astype(str)
            )

    print(f"Final enriched row count: {len(final_df):,}")
    return final_df


# =========================
# FINAL DEDUPLICATION
# =========================
def deduplicate_final_raw_by_ticket_id(
    final_df: pd.DataFrame,
) -> pd.DataFrame:
    PROGRESS.set_message(
        "Deduplicating final raw data by Ticket ID"
    )

    if final_df.empty or "Ticket ID" not in final_df.columns:
        return final_df.copy()

    work = final_df.copy()
    before_count = len(work)

    work["_original_row_order"] = range(len(work))
    work["_ticket_id_key"] = normalize_ticket_id_series(
        work["Ticket ID"]
    )

    blank_ticket_df = work[
        work["_ticket_id_key"].eq("")
    ].copy()
    keyed_df = work[
        work["_ticket_id_key"].ne("")
    ].copy()

    if keyed_df.empty:
        return (
            work.drop(
                columns=[
                    "_original_row_order",
                    "_ticket_id_key",
                ],
                errors="ignore",
            )
            .reset_index(drop=True)
        )

    keyed_df["_smiley_registered_at_dt"] = (
        parse_dates_general(
            keyed_df["Smiley Registered At"]
        )
    )
    keyed_df["_created_date_dt"] = parse_dates_general(
        keyed_df["Created Date"]
    )

    keyed_df = keyed_df.sort_values(
        by=[
            "_ticket_id_key",
            "_smiley_registered_at_dt",
            "_created_date_dt",
            "_original_row_order",
        ],
        ascending=[True, False, False, False],
        na_position="last",
        kind="mergesort",
    )

    deduped_keyed_df = keyed_df.drop_duplicates(
        subset=["_ticket_id_key"],
        keep="first",
    )

    final_deduped_df = pd.concat(
        [deduped_keyed_df, blank_ticket_df],
        ignore_index=True,
    )
    final_deduped_df = final_deduped_df.sort_values(
        by="_original_row_order",
        ascending=True,
        kind="mergesort",
    )

    final_deduped_df = final_deduped_df.drop(
        columns=[
            "_original_row_order",
            "_ticket_id_key",
            "_smiley_registered_at_dt",
            "_created_date_dt",
        ],
        errors="ignore",
    )

    for column in FINAL_OUTPUT_COLUMNS:
        if column not in final_deduped_df.columns:
            final_deduped_df[column] = ""

    final_deduped_df = final_deduped_df[
        FINAL_OUTPUT_COLUMNS
    ].reset_index(drop=True)

    after_count = len(final_deduped_df)
    removed_count = before_count - after_count

    duplicate_row_candidates = int(
        work.loc[
            work["_ticket_id_key"].ne(""),
            "_ticket_id_key",
        ].duplicated(keep=False).sum()
    )
    duplicate_ticket_ids_removed = int(
        work.loc[
            work["_ticket_id_key"].ne(""),
            "_ticket_id_key",
        ].duplicated(keep="first").sum()
    )

    print("======================================")
    print("FINAL TICKET ID DEDUPLICATION COMPLETE")
    print("======================================")
    print(f"Rows before dedupe: {before_count:,}")
    print(f"Rows after dedupe : {after_count:,}")
    print(f"Rows removed      : {removed_count:,}")
    print(
        "Duplicate-row candidates found: "
        f"{duplicate_row_candidates:,}"
    )
    print(
        "Duplicate Ticket IDs removed: "
        f"{duplicate_ticket_ids_removed:,}"
    )

    return final_deduped_df


# =========================
# WRITE RAW OUTPUT
# =========================
def dataframe_to_sheet_rows(
    final_df: pd.DataFrame,
) -> list:
    if final_df.empty:
        return []

    write_df = final_df[FINAL_OUTPUT_COLUMNS].copy()

    for column in NUMERIC_OUTPUT_COLUMNS:
        write_df[column] = (
            pd.to_numeric(
                write_df[column],
                errors="coerce",
            )
            .fillna(0)
            .astype("int64")
        )

    for column in AUDIT_BINARY_OUTPUT_COLUMNS:
        write_df[column] = write_df[column].map(
            normalize_audit_binary_value
        )

    for column in write_df.columns:
        if (
            column not in NUMERIC_OUTPUT_COLUMNS
            and column not in AUDIT_BINARY_OUTPUT_COLUMNS
        ):
            write_df[column] = (
                write_df[column]
                .fillna("")
                .astype(str)
            )

    return write_df.values.tolist()


def write_raw_output(final_df):
    print("======================================")
    print("WRITE RAW START")
    print("======================================")
    print(
        f"Destination columns: "
        f"{RAW_DEST_START_COLUMN}:{RAW_DEST_END_COLUMN}"
    )

    PROGRESS.add_total(3)
    PROGRESS.set_message("Ensuring raw sheet exists")

    ensure_sheet_exists(
        sheets_service,
        TARGET_SPREADSHEET_ID,
        RAW_SHEET_NAME,
    )

    print("Clearing raw destination range...")
    clear_range_with_retry(
        sheets_service,
        TARGET_SPREADSHEET_ID,
        RAW_DEST_CLEAR_RANGE,
    )
    PROGRESS.update(1, "Raw destination range cleared")

    print("Writing raw headers...")
    write_rows_to_sheet_with_retry(
        sheets_service=sheets_service,
        spreadsheet_id=TARGET_SPREADSHEET_ID,
        sheet_name=RAW_SHEET_NAME,
        start_row=1,
        rows=[FINAL_OUTPUT_COLUMNS],
        start_col=RAW_DEST_START_COLUMN,
        end_col=RAW_DEST_END_COLUMN,
    )
    PROGRESS.update(1, "Raw headers written")

    if final_df.empty:
        print("No rows to write.")
        format_raw_sheet_columns(
            sheets_service=sheets_service,
            spreadsheet_id=TARGET_SPREADSHEET_ID,
            sheet_name=RAW_SHEET_NAME,
        )
        PROGRESS.update(1, "Raw sheet formatted")
        return 0

    rows = dataframe_to_sheet_rows(final_df)
    total_batches = math.ceil(
        len(rows) / SHEETS_WRITE_BATCH_ROWS
    )
    PROGRESS.add_total(total_batches)

    total_rows_written = 0
    next_sheet_row = 2

    for batch_number, start_index in enumerate(
        range(0, len(rows), SHEETS_WRITE_BATCH_ROWS),
        start=1,
    ):
        chunk = rows[
            start_index:start_index + SHEETS_WRITE_BATCH_ROWS
        ]

        write_rows_to_sheet_with_retry(
            sheets_service=sheets_service,
            spreadsheet_id=TARGET_SPREADSHEET_ID,
            sheet_name=RAW_SHEET_NAME,
            start_row=next_sheet_row,
            rows=chunk,
            start_col=RAW_DEST_START_COLUMN,
            end_col=RAW_DEST_END_COLUMN,
        )

        next_sheet_row += len(chunk)
        total_rows_written += len(chunk)

        print(
            f"  Batch {batch_number}/{total_batches}: "
            f"wrote {len(chunk):,} rows"
        )
        PROGRESS.update(
            1,
            f"Writing raw rows: "
            f"{total_rows_written:,}/{len(rows):,}",
        )

    format_raw_sheet_columns(
        sheets_service=sheets_service,
        spreadsheet_id=TARGET_SPREADSHEET_ID,
        sheet_name=RAW_SHEET_NAME,
    )
    PROGRESS.update(1, "Raw sheet formatted")

    print(
        f"Total rows written to raw: "
        f"{total_rows_written:,}"
    )
    return total_rows_written


# =========================
# MAIN
# =========================
def main():
    PROGRESS.start()
    PROGRESS.add_total(7)

    summary_rows = []
    merchant_result = None
    final_df = pd.DataFrame(columns=FINAL_OUTPUT_COLUMNS)
    total_rows_written = 0

    try:
        merchant_result = extract_merchant_data(
            summary_rows=summary_rows
        )
        PROGRESS.update(1, "Merchant extraction complete")

        merchant_df = merchant_result["merchant_df"]
        window_start_date = merchant_result[
            "window_start_date"
        ]
        window_end_date = merchant_result[
            "window_end_date"
        ]

        taxonomy_lookups = build_taxonomy_lookups(
            merchant_df=merchant_df,
            window_start_date=window_start_date,
            window_end_date=window_end_date,
            summary_rows=summary_rows,
        )
        PROGRESS.update(1, "Taxonomy lookups complete")

        ticket_lookups = build_ticket_lookups(
            merchant_df=merchant_df,
            window_start_date=window_start_date,
            window_end_date=window_end_date,
            summary_rows=summary_rows,
        )
        PROGRESS.update(1, "Ticket lookups complete")

        audit_lookup_df = build_audit_lookup(
            merchant_df=merchant_df,
            window_start_date=window_start_date,
            window_end_date=window_end_date,
            summary_rows=summary_rows,
        )
        PROGRESS.update(1, "Elevate QA lookup complete")

        final_df = enrich_and_calculate(
            merchant_df=merchant_df,
            taxonomy_lookups=taxonomy_lookups,
            ticket_lookups=ticket_lookups,
            audit_lookup_df=audit_lookup_df,
        )
        PROGRESS.update(
            1,
            "Enrichment and calculations complete",
        )

        merchant_row_count = len(merchant_df)
        final_row_count = len(final_df)

        if final_row_count != merchant_row_count:
            raise RuntimeError(
                "Row preservation validation failed. "
                f"Merchant master has {merchant_row_count:,} rows, "
                f"but enrichment produced {final_row_count:,} rows. "
                "The raw destination was NOT updated."
            )

        print("======================================")
        print("ROW PRESERVATION VALIDATION COMPLETE")
        print("======================================")
        print(f"Merchant master rows: {merchant_row_count:,}")
        print(f"Final enriched rows : {final_row_count:,}")
        print("Rows removed         : 0")

        PROGRESS.update(
            1,
            "Row preservation validation complete",
        )

        total_rows_written = write_raw_output(final_df)
        PROGRESS.update(1, "Raw sheet write complete")

    finally:
        write_summary_table(
            sheets_service=sheets_service,
            spreadsheet_id=TARGET_SPREADSHEET_ID,
            summary_sheet_name=SUMMARY_SHEET_NAME,
            rows=summary_rows,
        )
        PROGRESS.close()

    print("======================================")
    print("MASTER LOAD COMPLETE")
    print("======================================")

    if merchant_result is not None:
        print(
            f"Window used: "
            f"{merchant_result['window_start_date']} "
            f"to {merchant_result['window_end_date']}"
        )
        print(
            "Merchant reference latest date: "
            f"{merchant_result['reference_latest_date']}"
        )

    print(f"Final enriched rows: {len(final_df):,}")
    print(f"Rows written to raw: {total_rows_written:,}")
    print(
        f"Final raw width: "
        f"{len(FINAL_OUTPUT_COLUMNS)} columns "
        f"({RAW_DEST_START_COLUMN}:{RAW_DEST_END_COLUMN})"
    )
    print(f"Summary written to: {SUMMARY_SHEET_NAME}")
    print("Done.")


main()
