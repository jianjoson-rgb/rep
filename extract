def normalize_ticket_id_series(series: pd.Series) -> pd.Series:
    """
    Normalize plain Ticket IDs and extract IDs from Zendesk-style ticket URLs.

    Supported examples:
      65493820
      65493820.0
      https://company.tool.com/agent/tickets/65493820
      https://company.tool.com/agent/tickets/65493820?foo=bar
    """
    clean = series.fillna("").astype(str).str.strip()
    clean = clean.where(~clean.str.casefold().isin(INVALID_LOOKUP_VALUES), "")
    clean = clean.str.replace(r"[?#].*$", "", regex=True).str.rstrip("/")

    zendesk_id = clean.str.extract(
        r"(?i)(?:^|/)tickets/(\d+)(?:/|$)",
        expand=False,
    ).fillna("")

    decimal_integer = clean.str.extract(
        r"^\s*(\d+)\.0+\s*$",
        expand=False,
    ).fillna("")

    digits_only = clean.where(clean.str.fullmatch(r"\d+", na=False), "")

    last_numeric_group = clean.str.extract(
        r"(\d+)(?!.*\d)",
        expand=False,
    ).fillna("")

    result = zendesk_id.copy()
    result = result.where(result != "", decimal_integer)
    result = result.where(result != "", digits_only)
    result = result.where(result != "", last_numeric_group)

    return result.fillna("").astype(str).str.strip()


def normalize_ticket_id_value(value) -> str:
    """Fast scalar Ticket ID normalization for row-wise Google Sheets reads."""
    if pd.isna(value):
        return ""

    text = str(value).strip()
    if text.casefold() in INVALID_LOOKUP_VALUES:
        return ""

    text = re.sub(r"[?#].*$", "", text).rstrip("/")

    zendesk_match = re.search(
        r"(?i)(?:^|/)tickets/(\d+)(?:/|$)",
        text,
    )
    if zendesk_match:
        return zendesk_match.group(1)

    decimal_integer_match = re.fullmatch(r"\s*(\d+)\.0+\s*", text)
    if decimal_integer_match:
        return decimal_integer_match.group(1)

    if re.fullmatch(r"\d+", text):
        return text

    numeric_groups = re.findall(r"\d+", text)
    return numeric_groups[-1] if numeric_groups else ""


def build_combined_key(ticket_id, employee_name) -> str:
    ticket_key = normalize_ticket_id_value(ticket_id)
    name_key = normalize_lookup_text(employee_name)
    if not ticket_key or not name_key:
        return ""
    return f"{ticket_key}||{name_key}"


def build_combined_key_series(
    ticket_series: pd.Series,
    name_series: pd.Series,
) -> pd.Series:
    ticket_norm = normalize_ticket_id_series(ticket_series)
    name_norm = normalize_lookup_series(name_series)
    valid = (ticket_norm != "") & (name_norm != "")

    combined = pd.Series(
        [""] * len(ticket_series),
        index=ticket_series.index,
        dtype="object",
    )
    combined.loc[valid] = (
        ticket_norm.loc[valid] + "||" + name_norm.loc[valid]
    )
    return combined


