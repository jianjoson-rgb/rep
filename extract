        "sort_key": (year, month),
    }


def parse_elevate_qa_filename(file_name: str):
    match = ELEVATE_QA_FILE_REGEX.match(str(file_name).strip())
    if not match:
        return None

    year = int(match.group("year"))
    month = int(match.group("month"))
    day = int(match.group("day"))

    try:
        file_date = date(year, month, day)
    except ValueError:
        return None

    return {
        "year": year,
        "month": month,
        "day": day,
        "file_date": file_date,
        "sort_key": (year, month, day),
    }


def ensure_taxonomy_standard_columns(
    chunk: pd.DataFrame,
) -> pd.DataFrame:
    if "Ticket ID" not in chunk.columns:
        chunk["Ticket ID"] = ""

    chunk["Ticket ID"] = normalize_ticket_id_series(
        chunk["Ticket ID"]
    )

    if "Ticket URL" in chunk.columns:
        derived_ticket_id = normalize_ticket_id_series(
            chunk["Ticket URL"]
        )
        blank_ticket_mask = chunk["Ticket ID"].eq("")
        chunk.loc[blank_ticket_mask, "Ticket ID"] = (
