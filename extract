        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %I:%M:%S %p",
        "%m/%d/%Y %H:%M:%S",
        "%m/%d/%Y %I:%M:%S %p",
        "%m/%d/%Y",
        "%Y-%m-%d",
    ]
    return parse_dates_with_known_formats(series, formats)


def count_invalid_datetime_values(
    raw_series: pd.Series,
    parsed_series: pd.Series,
) -> int:
    raw_clean = clean_mojibake_datetime_series(raw_series)
    nonblank_mask = (
        raw_clean.ne("")
        & ~raw_clean.str.casefold().isin(INVALID_LOOKUP_VALUES)
    )
    return int((nonblank_mask & parsed_series.isna()).sum())


def format_created_date_output(
