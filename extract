def list_all_matching_source_files(
    drive_service,
    folder_id,
    filename_parser,
):
    query = f"'{folder_id}' in parents and trashed = false"
    files = []
    page_token = None

    while True:
        response = run_with_retry(
            "List source files",
            lambda: drive_service.files().list(
                q=query,
                fields=(
                    "nextPageToken, "
                    "files(id, name, modifiedTime, size)"
                ),
                pageToken=page_token,
                pageSize=1_000,
                supportsAllDrives=True,
                includeItemsFromAllDrives=True,
            ).execute(),
        )

        for file_meta in response.get("files", []):
            parsed = filename_parser(file_meta["name"])
            if parsed:
                file_meta["parsed_filename"] = parsed
                files.append(file_meta)

        page_token = response.get("nextPageToken")
        if not page_token:
            break

    files.sort(
        key=lambda item: item["parsed_filename"]["sort_key"]
    )
    return files


def download_drive_file_with_retry(
    drive_service,
    file_id,
    file_name,
    temp_prefix,
):
    last_error = None

    for attempt in range(1, MAX_RETRIES + 1):
        temp_dir = tempfile.mkdtemp(prefix=temp_prefix)
        local_path = os.path.join(temp_dir, file_name)

        try:
            request = drive_service.files().get_media(
                fileId=file_id,
                supportsAllDrives=True,
            )

            with open(local_path, "wb") as file_handle:
                downloader = MediaIoBaseDownload(
                    file_handle,
                    request,
                )
                done = False
                while not done:
                    status, done = downloader.next_chunk()
                    if status and SHOW_FILE_DOWNLOAD_PROGRESS:
                        print(
                            "    Download progress: "
                            f"{int(status.progress() * 100)}%"
                        )

            return local_path

        except Exception as exc:
            last_error = exc
            print(
                f"Download failed on attempt "
                f"{attempt}/{MAX_RETRIES} for {file_name}: {exc}"
            )
            safe_cleanup_file(local_path)

            if attempt < MAX_RETRIES:
                retry_sleep(attempt)

    raise last_error


def get_latest_file_by_filename(files):
    if not files:
        raise ValueError(
            "No matching source files were found in the folder."
        )

    return max(
        files,
        key=lambda item: item["parsed_filename"]["sort_key"],
    )


def get_latest_date_from_file(
    drive_service,
    file_meta,
    required_columns,
    date_column,
    company_column,
    company_filter_value,
    parse_dates_func,
    temp_prefix,
    header_mapper_func=None,
):
    file_name = file_meta["name"]
    local_csv = None
    file_max_date = None

    try:
        print("--------------------------------------------------")
        print(f"Scanning latest date from latest file: {file_name}")
        PROGRESS.set_message(
            f"Scanning latest date: {file_name}"
        )

        local_csv = download_drive_file_with_retry(
            drive_service=drive_service,
            file_id=file_meta["id"],
            file_name=file_name,
            temp_prefix=temp_prefix,
        )

        header_df = pd.read_csv(
            local_csv,
            nrows=0,
            dtype=str,
            keep_default_na=False,
            low_memory=False,
        )

        if header_mapper_func is None:
            _, rename_map, _ = validate_and_map_headers(
                list(header_df.columns),
                required_columns,
                file_name,
            )
        else:
            _, rename_map, _ = header_mapper_func(
                list(header_df.columns),
                file_name,
            )

        actual_date_column = next(
            actual
            for actual, expected in rename_map.items()
            if expected == date_column
        )
        actual_company_column = next(
            actual
            for actual, expected in rename_map.items()
            if expected == company_column
        )

        chunk_iter = pd.read_csv(
            local_csv,
            dtype=str,
            keep_default_na=False,
            low_memory=False,
            chunksize=CSV_CHUNK_SIZE,
            usecols=[actual_date_column, actual_company_column],
        )

        company_target = company_filter_value.casefold()
        invalid_date_rows = 0

        for chunk_number, chunk in enumerate(chunk_iter, start=1):
            chunk = chunk.rename(columns=rename_map)
            company_mask = (
                normalize_lookup_series(chunk[company_column])
                == company_target
            )
            date_series = parse_dates_func(chunk[date_column])

            invalid_date_rows += count_invalid_datetime_values(
                chunk.loc[company_mask, date_column],
                date_series.loc[company_mask],
            )

            valid_dates = date_series[
                company_mask & date_series.notna()
            ]

            if not valid_dates.empty:
                chunk_max = valid_dates.max()
                if (
                    file_max_date is None
                    or chunk_max > file_max_date
                ):
                    file_max_date = chunk_max

            if chunk_number % 5 == 0:
                PROGRESS.set_message(
                    f"Scanned {chunk_number} chunks from {file_name}"
                )

        if file_max_date is None:
            raise ValueError(
                f"No valid '{date_column}' values found for "
                f"company '{company_filter_value}' in {file_name}."
            )

        print(f"  Latest {date_column}: {file_max_date}")
        if invalid_date_rows:
            print(
                f"  Invalid {date_column} rows skipped: "
                f"{invalid_date_rows:,}"
            )

        return file_max_date

    finally:
        safe_cleanup_file(local_csv)


