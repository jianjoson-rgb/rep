        sheets_service,
        spreadsheet_id,
        f"{summary_sheet_name}!A:L",
    )

    all_rows = [SUMMARY_HEADERS] + rows
    batch_size = 1_000
    total_batches = math.ceil(len(all_rows) / batch_size)
    PROGRESS.add_total(total_batches)

    next_row = 1
    for batch_number, start_index in enumerate(
        range(0, len(all_rows), batch_size),
        start=1,
    ):
        chunk = all_rows[
            start_index:start_index + batch_size
        ]

        write_rows_to_sheet_with_retry(
            sheets_service=sheets_service,
            spreadsheet_id=spreadsheet_id,
            sheet_name=summary_sheet_name,
            start_row=next_row,
            rows=chunk,
            start_col="A",
            end_col="L",
        )

        next_row += len(chunk)
        PROGRESS.update(
            1,
            f"Writing load summary batch "
            f"{batch_number}/{total_batches}",
        )


