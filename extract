def compute_week_label(series: pd.Series) -> pd.Series:
    valid = series.notna()
    out = pd.Series(
        [""] * len(series),
        index=series.index,
        dtype="object",
    )
    if valid.any():
        base_dates = series.loc[valid].dt.normalize()
        days_since_sunday = (base_dates.dt.weekday + 1) % 7
        result_dates = (
            base_dates
            - pd.to_timedelta(days_since_sunday, unit="D")
        )
        out.loc[valid] = "WB" + result_dates.dt.strftime("%m%d")
    return out


def format_month_output(series: pd.Series) -> pd.Series:
    valid = series.notna()
    out = pd.Series(
        [""] * len(series),
        index=series.index,
        dtype="object",
    )
    if valid.any():
        out.loc[valid] = series.loc[valid].dt.strftime("%m")
    return out


def compute_ticket_age(
    smiley_dt: pd.Series,
    created_dt: pd.Series,
    null_text: str = "null",
) -> pd.Series:
    out = pd.Series(
        [null_text] * len(smiley_dt),
        index=smiley_dt.index,
        dtype="object",
    )
    valid = smiley_dt.notna() & created_dt.notna()

    if valid.any():
        diff_days = (
            smiley_dt.loc[valid] - created_dt.loc[valid]
        ).dt.total_seconds() / 86_400.0

        ceil_days = diff_days.apply(
            lambda value: (
                int(math.ceil(value))
                if pd.notna(value)
                else None
            )
        )

        def to_label(days):
            if days is None:
                return null_text
            if days <= 1:
                return "1 Day"
            if days > 7:
                return ">7 Days"
            return f"{days} Days"

        out.loc[valid] = ceil_days.map(to_label)

    return out


def month_keys_between(start_date, end_date):
    keys = []
    year = start_date.year
    month = start_date.month

    while (year, month) <= (end_date.year, end_date.month):
        keys.append((year, month))
        if month == 12:
            year += 1
            month = 1
        else:
            month += 1

    return keys


def validate_and_map_headers(
    header_cols,
    required_columns,
    file_name,
    optional_columns=None,
):
    normalized_lookup = {}
    for column in header_cols:
        key = canonical_header(column)
        if key not in normalized_lookup:
            normalized_lookup[key] = column

    missing = [
        column
        for column in required_columns
        if canonical_header(column) not in normalized_lookup
    ]
    if missing:
        raise ValueError(
            f"{file_name}: missing required columns: {missing}. "
            f"Found columns: "
            f"{[normalize_header(c) for c in header_cols]}"
        )

    actual_source_columns = []
    rename_map = {}

    for column in required_columns:
        actual = normalized_lookup[canonical_header(column)]
        actual_source_columns.append(actual)
        rename_map[actual] = column

    present_optional = set()
    for column in optional_columns or []:
        key = canonical_header(column)
        if key in normalized_lookup:
            actual = normalized_lookup[key]
            actual_source_columns.append(actual)
            rename_map[actual] = column
            present_optional.add(column)

    deduped_actuals = list(dict.fromkeys(actual_source_columns))
    return deduped_actuals, rename_map, present_optional


def find_actual_header_by_alias(header_cols, aliases):
    normalized_lookup = {}
    for column in header_cols:
        key = canonical_header(column)
        if key not in normalized_lookup:
            normalized_lookup[key] = column

    for alias in aliases:
        actual = normalized_lookup.get(canonical_header(alias))
        if actual is not None:
            return actual

    return None


def find_header_index_by_alias(headers, aliases):
    canonical_headers = [canonical_header(header) for header in headers]

    for alias in aliases:
        alias_key = canonical_header(alias)
        for index, header_key in enumerate(canonical_headers):
            if header_key == alias_key:
                return index

    for alias in aliases:
        alias_key = canonical_header(alias)
        if not alias_key:
            continue
        for index, header_key in enumerate(canonical_headers):
            if alias_key in header_key:
                return index

    return None


def validate_and_map_taxonomy_headers(
    header_cols,
    file_name,
    require_ticket=True,
):
    actual_source_columns = []
    rename_map = {}
    present_columns = set()

    for canonical_column, aliases in TAXONOMY_HEADER_ALIASES.items():
        actual = find_actual_header_by_alias(header_cols, aliases)
        if actual is not None:
            actual_source_columns.append(actual)
            rename_map[actual] = canonical_column
            present_columns.add(canonical_column)

    missing_required = [
        column
        for column in ["Interaction Date", "Company"]
        if column not in present_columns
    ]

    if (
        require_ticket
        and "Ticket ID" not in present_columns
        and "Ticket URL" not in present_columns
    ):
        missing_required.append("Ticket ID or Ticket URL")

    if missing_required:
        raise ValueError(
            f"{file_name}: missing required taxonomy columns: "
            f"{missing_required}. Found columns: "
            f"{[normalize_header(c) for c in header_cols]}"
        )

    deduped_actuals = list(dict.fromkeys(actual_source_columns))
    return deduped_actuals, rename_map, present_columns


def parse_merchant_filename(file_name: str):
    match = MERCHANT_FILE_REGEX.match(str(file_name).strip())
    if not match:
        return None

    month_abbr = match.group("month").upper()
    year = int(match.group("year"))

    if month_abbr not in MONTH_MAP:
        return None

    month = MONTH_MAP[month_abbr]
    return {
        "year": year,
        "month": month,
        "sort_key": (year, month),
    }


def parse_six_digit_month_year_token(date_token: str):
    token = str(date_token).strip()
    if not re.fullmatch(r"\d{6}", token):
        return None

    month_from_left = int(token[:2])
    year_from_right = int(token[2:6])
    if 1 <= month_from_left <= 12 and 1900 <= year_from_right <= 2100:
        return {
            "yyyymm": f"{year_from_right:04d}{month_from_left:02d}",
            "mmyyyy": f"{month_from_left:02d}{year_from_right:04d}",
            "year": year_from_right,
            "month": month_from_left,
            "sort_key": (year_from_right, month_from_left),
        }

    year_from_left = int(token[:4])
    month_from_right = int(token[4:6])
    if 1 <= month_from_right <= 12 and 1900 <= year_from_left <= 2100:
        return {
            "yyyymm": f"{year_from_left:04d}{month_from_right:02d}",
            "mmyyyy": f"{month_from_right:02d}{year_from_left:04d}",
            "year": year_from_left,
            "month": month_from_right,
            "sort_key": (year_from_left, month_from_right),
        }

    return None


def parse_taxonomy_filename(file_name: str):
    clean_name = str(file_name).strip()
    match = ROUTING_TOPICS_FILE_REGEX.match(clean_name)

    if not match:
        match = LEGACY_TAXONOMY_FILE_REGEX.match(clean_name)

    if not match:
        return None

    return parse_six_digit_month_year_token(
        match.group("date_token")
    )


def parse_tickets_filename(file_name: str):
    match = TICKETS_FILE_REGEX.match(str(file_name).strip())
    if not match:
        return None

    month_abbr = match.group("month").upper()
    year = int(match.group("year"))

    if month_abbr not in MONTH_MAP:
        return None

    month = MONTH_MAP[month_abbr]
    return {
