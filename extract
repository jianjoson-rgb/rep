        required_columns=TAXONOMY_REQUIRED_COLUMNS,
        date_column=TAXONOMY_DATE_COLUMN,
        company_column=TAXONOMY_COMPANY_COLUMN,
        company_filter_value=TAXONOMY_COMPANY_FILTER_VALUE,
        parse_dates_func=parse_dates_taxonomy,
        temp_prefix="taxonomy_csv_",
        header_mapper_func=(
            lambda headers, file_name:
            validate_and_map_taxonomy_headers(
                headers,
                file_name,
                require_ticket=False,
            )
        ),
    )
    PROGRESS.update(1, "Taxonomy latest-date scan complete")

    reference_latest_date = latest_create_datetime.date()
    needed_months = set(
        month_keys_between(window_start_date, window_end_date)
    )
    source_files = [
        file_meta
        for file_meta in all_source_files
        if file_meta["parsed_filename"]["sort_key"]
        in needed_months
    ]

    if not source_files:
        print("No taxonomy files matched the merchant window.")
        return empty_result

    print(
        f"Taxonomy window: "
        f"{window_start_date} to {window_end_date}"
    )
    print(f"Taxonomy files to process: {len(source_files)}")
    PROGRESS.add_total(len(source_files))

    enrich_best = {}
    tenure_combined_best = {}
    tenure_name_best = {}
    site_name_best = {}

    start_ts = pd.Timestamp(window_start_date)
    end_ts_exclusive = (
        pd.Timestamp(window_end_date)
        + pd.Timedelta(days=1)
    )
    company_target = TAXONOMY_COMPANY_FILTER_VALUE.casefold()

    for file_meta in source_files:
        file_name = file_meta["name"]
        modified_time = file_meta.get("modifiedTime", "")
        file_size_mb = (
            round(
                int(file_meta.get("size", 0))
                / (1024 * 1024),
                2,
            )
            if file_meta.get("size")
            else ""
        )
        matched_rows = 0
        invalid_date_rows = 0
        file_status = "SUCCESS"
        local_csv = None

        print("--------------------------------------------------")
        print(f"Processing taxonomy file: {file_name}")
        PROGRESS.set_message(
            f"Processing taxonomy file: {file_name}"
        )

        try:
            local_csv = download_drive_file_with_retry(
                drive_service,
                file_meta["id"],
                file_name,
                "taxonomy_csv_",
            )

            header_df = pd.read_csv(
                local_csv,
                nrows=0,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
            )

            actual_columns, rename_map, _ = (
                validate_and_map_taxonomy_headers(
                    list(header_df.columns),
                    file_name,
                    require_ticket=True,
                )
            )

            chunk_iter = pd.read_csv(
                local_csv,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
                chunksize=CSV_CHUNK_SIZE,
                usecols=actual_columns,
            )

            for chunk_number, chunk in enumerate(
                chunk_iter,
                start=1,
            ):
                chunk = chunk.rename(columns=rename_map)
                chunk = ensure_taxonomy_standard_columns(chunk)

                company_mask = (
                    normalize_lookup_series(
                        chunk[TAXONOMY_COMPANY_COLUMN]
                    )
                    == company_target
                )
                date_series = parse_dates_taxonomy(
                    chunk[TAXONOMY_DATE_COLUMN]
                )

                invalid_date_rows += count_invalid_datetime_values(
                    chunk.loc[
                        company_mask,
                        TAXONOMY_DATE_COLUMN,
                    ],
                    date_series.loc[company_mask],
                )

                base_mask = (
                    company_mask
                    & date_series.notna()
                    & (date_series >= start_ts)
                    & (date_series < end_ts_exclusive)
                )

                ticket_id_series = normalize_ticket_id_series(
                    chunk["Ticket ID"]
                )
                employee_name_display = normalize_display_series(
                    chunk["Employee Name"]
                )
                employee_name_lookup = normalize_lookup_series(
                    chunk["Employee Name"]
                )
                combined_key_series = build_combined_key_series(
                    ticket_id_series,
                    employee_name_display,
                )

                enrich_mask = (
                    base_mask
                    & ticket_id_series.isin(needed_ticket_ids)
                )

                if enrich_mask.any():
                    matched_rows += int(enrich_mask.sum())

                    enrich_records = pd.DataFrame(
                        {
                            "Ticket ID": (
                                ticket_id_series.loc[enrich_mask]
                            ),
                            "Level One": (
                                chunk.loc[enrich_mask, "Level One"]
                            ),
                            "Level Two": (
                                chunk.loc[enrich_mask, "Level Two"]
                            ),
                            "Create Date": (
                                date_series.loc[enrich_mask]
                            ),
                        }
                    )

                    for record in enrich_records.to_dict("records"):
                        ticket_id = record["Ticket ID"]
                        create_date = record["Create Date"]

                        if not ticket_id or pd.isna(create_date):
                            continue

                        existing = enrich_best.get(ticket_id)
                        if (
                            existing is None
                            or create_date > existing["Create Date"]
                        ):
                            enrich_best[ticket_id] = {
                                "Ticket ID": ticket_id,
                                "Create Date": create_date,
                                "Level One": normalize_display_text(
                                    record.get("Level One", "")
                                ),
                                "Level Two": normalize_display_text(
                                    record.get("Level Two", "")
                                ),
                            }

                tenure_display = normalize_display_series(
                    chunk["Tenure"]
                )
                tenure_lookup = normalize_lookup_series(
                    chunk["Tenure"]
                )
                tenure_usable = (
                    ~tenure_lookup.isin(INVALID_LOOKUP_VALUES)
                    & tenure_display.ne("")
                )
                tenure_mask = base_mask & tenure_usable

                if tenure_mask.any():
                    combined_mask = (
                        tenure_mask
                        & combined_key_series.isin(
                            needed_combined_keys
                        )
                    )

                    for combined_key, value, record_date in zip(
                        combined_key_series.loc[
                            combined_mask
                        ].tolist(),
                        tenure_display.loc[
                            combined_mask
                        ].tolist(),
                        date_series.loc[
                            combined_mask
                        ].tolist(),
                    ):
                        existing = tenure_combined_best.get(
                            combined_key
                        )
                        if (
                            existing is None
                            or record_date > existing["date"]
                        ):
                            tenure_combined_best[combined_key] = {
                                "value": value,
                                "date": record_date,
                            }

                    name_mask = (
                        tenure_mask
                        & employee_name_lookup.isin(
                            needed_name_keys
                        )
                    )

                    for name_key, value, record_date in zip(
                        employee_name_lookup.loc[
                            name_mask
                        ].tolist(),
                        tenure_display.loc[name_mask].tolist(),
                        date_series.loc[name_mask].tolist(),
                    ):
                        existing = tenure_name_best.get(name_key)
                        if (
                            existing is None
                            or record_date > existing["date"]
                        ):
                            tenure_name_best[name_key] = {
                                "value": value,
                                "date": record_date,
                            }

                site_source_lookup = normalize_lookup_series(
                    chunk["BPO Site"]
                )
                site_code_series = site_source_lookup.map(
                    TAXONOMY_SITE_TO_CODE
                )
                site_mask = (
                    base_mask
                    & employee_name_lookup.isin(
                        needed_name_keys
                    )
                    & site_code_series.notna()
                )

                for name_key, site_code, record_date in zip(
                    employee_name_lookup.loc[site_mask].tolist(),
                    site_code_series.loc[site_mask].tolist(),
                    date_series.loc[site_mask].tolist(),
                ):
                    existing = site_name_best.get(name_key)
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        site_name_best[name_key] = {
                            "value": site_code,
                            "date": record_date,
                        }

                if chunk_number % 5 == 0:
                    PROGRESS.set_message(
                        f"Taxonomy {file_name}: "
                        f"{matched_rows:,} matched rows"
                    )

            if invalid_date_rows:
                file_status = (
                    "SUCCESS; invalid "
                    f"{TAXONOMY_DATE_COLUMN} rows skipped: "
                    f"{invalid_date_rows:,}"
                )
                print(
                    f"  Invalid {TAXONOMY_DATE_COLUMN} "
                    f"rows skipped: {invalid_date_rows:,}"
                )

        except Exception as exc:
            file_status = f"FAILED: {exc}"
            print(
                f"ERROR processing taxonomy file "
                f"{file_name}: {exc}"
            )
            raise

        finally:
            summary_rows.append(
                [
                    "TAXONOMY_LOOKUPS",
                    run_timestamp,
                    LOOKBACK_WEEKS,
                    str(window_start_date),
                    str(window_end_date),
                    latest_file_name,
                    str(reference_latest_date),
                    file_name,
                    modified_time,
                    file_size_mb,
                    matched_rows,
                    file_status,
                ]
            )
            safe_cleanup_file(local_csv)
            PROGRESS.update(
                1,
                f"Taxonomy file complete: {file_name}",
            )

    if enrich_best:
        enrich_df = pd.DataFrame(enrich_best.values())
        enrich_df = enrich_df.rename(
            columns={"Create Date": "Created Date"}
        )
        enrich_df["Created Date Raw"] = (
            enrich_df["Created Date"]
        )
        enrich_df["Created Date"] = (
            format_created_date_output(
                enrich_df["Created Date"],
                null_text=NULL_TEXT,
            )
        )
        enrich_df = enrich_df[
            [
                "Ticket ID",
                "Created Date",
                "Created Date Raw",
                "Level One",
                "Level Two",
            ]
        ]
    else:
        enrich_df = empty_result["enrich_df"]

    return {
        "enrich_df": enrich_df,
        "tenure_combined": {
            key: value["value"]
            for key, value in tenure_combined_best.items()
        },
        "tenure_name": {
            key: value["value"]
            for key, value in tenure_name_best.items()
        },
        "site_name": {
            key: value["value"]
            for key, value in site_name_best.items()
        },
    }


