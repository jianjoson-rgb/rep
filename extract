def compute_ramp_from_tenure_group(
    tenure_series: pd.Series,
    null_text: str = "null",
) -> pd.Series:
    tenure_clean = tenure_series.fillna("").astype(str).str.strip()
    out = pd.Series(
        [null_text] * len(tenure_series),
        index=tenure_series.index,
        dtype="object",
    )

    usable_mask = (
        tenure_clean.ne("")
        & ~tenure_clean.str.casefold().isin(INVALID_LOOKUP_VALUES)
    )

    if usable_mask.any():
        ramping_mask = (
            usable_mask
            & tenure_clean.str.contains(
                r"(?i)^[a-f]\.",
                regex=True,
                na=False,
            )
        )
        ramped_mask = (
            usable_mask
            & tenure_clean.str.contains(
                r"(?i)^[g-n]\.",
                regex=True,
                na=False,
            )
        )

        out.loc[ramping_mask] = "Ramping (a. 0-6 Months)"
        out.loc[ramped_mask] = "Ramped (b. 6+ Months)"

    return out


def retry_sleep(attempt_number: int) -> None:
    wait_seconds = (
        INITIAL_RETRY_WAIT_SECONDS
        * (BACKOFF_MULTIPLIER ** (attempt_number - 1))
    )
    print(f"    Retry wait: {wait_seconds} seconds...")
    time.sleep(wait_seconds)


def run_with_retry(label, fn):
    last_error = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            return fn()
        except Exception as exc:
            last_error = exc
            print(
                f"{label} failed on attempt "
                f"{attempt}/{MAX_RETRIES}: {exc}"
            )
            if attempt < MAX_RETRIES:
                retry_sleep(attempt)
    raise last_error


def safe_cleanup_file(local_path: str) -> None:
    try:
        if local_path and os.path.exists(local_path):
            folder = os.path.dirname(local_path)
            os.remove(local_path)
            shutil.rmtree(folder, ignore_errors=True)
    except Exception:
        pass


def parse_dates_general(series: pd.Series) -> pd.Series:
    try:
        parsed = pd.to_datetime(series, errors="coerce", format="mixed")
    except Exception:
        parsed = pd.to_datetime(series, errors="coerce")

    try:
        if getattr(parsed.dt, "tz", None) is not None:
            parsed = parsed.dt.tz_convert(None)
    except Exception:
        pass

    try:
        parsed = parsed.dt.tz_localize(None)
    except Exception:
        pass

    return parsed


def clean_mojibake_datetime_series(series: pd.Series) -> pd.Series:
    out = series.fillna("").astype(str)
    out = out.str.replace("\u202f", " ", regex=False)
    out = out.str.replace("\xa0", " ", regex=False)
    out = out.str.replace("â€¯", " ", regex=False)
    out = out.str.replace(r"\s+", " ", regex=True).str.strip()
    out = out.str.replace(r",\s+", ", ", regex=True)
    out = out.str.replace(
        r"(?i)(\d)(am|pm)\b",
        lambda match: f"{match.group(1)} {match.group(2).upper()}",
        regex=True,
    )
    out = out.str.replace(
        r"(?i)\b(am|pm)\b",
        lambda match: match.group(1).upper(),
        regex=True,
    )
    return out


def parse_dates_with_known_formats(
    series: pd.Series,
    formats: list[str],
) -> pd.Series:
    cleaned = clean_mojibake_datetime_series(series)
    parsed = pd.Series(
        pd.NaT,
        index=series.index,
        dtype="datetime64[ns]",
    )

    remaining_mask = cleaned.ne("")

    for fmt in formats:
        if not remaining_mask.any():
            break

        candidate = pd.to_datetime(
            cleaned.loc[remaining_mask],
            errors="coerce",
            format=fmt,
        )

        success_mask = candidate.notna()
        if success_mask.any():
            success_index = candidate.index[success_mask]
            parsed.loc[success_index] = candidate.loc[success_index]
            remaining_mask.loc[success_index] = False

    if remaining_mask.any():
        try:
            fallback = pd.to_datetime(
                cleaned.loc[remaining_mask],
                errors="coerce",
                format="mixed",
            )
        except (TypeError, ValueError):
            with warnings.catch_warnings():
                warnings.simplefilter("ignore", UserWarning)
                fallback = pd.to_datetime(
                    cleaned.loc[remaining_mask],
                    errors="coerce",
                )

        success_mask = fallback.notna()
        if success_mask.any():
            success_index = fallback.index[success_mask]
            parsed.loc[success_index] = fallback.loc[success_index]

    try:
        if getattr(parsed.dt, "tz", None) is not None:
            parsed = parsed.dt.tz_convert(None)
    except Exception:
        pass

    try:
        parsed = parsed.dt.tz_localize(None)
    except Exception:
        pass

    return parsed


def parse_dates_taxonomy(series: pd.Series) -> pd.Series:
    formats = [
